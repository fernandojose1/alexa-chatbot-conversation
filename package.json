{
  "name": "alexa-chatbot-conversation",
  "version": "1.0.0",
  "description": "Utilize Amazon Alexa devices to interface with ChatGPT Conversations",
  "main": "lambda/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy:skill": "ask deploy --ignore-hash",
    "deploy:skill-only": "ask deploy --target skill --ignore-hash",
    "deploy:model": "ask deploy --target model --ignore-hash",
    "skill:dialog": "ask dialog --locale en-US",
    "skill:validate": "ask smapi validate-skill --skill-id amzn1.ask.skill.8f78057b-a2b4-4386-b4c4-c99d1f0244d7",
    "skill:status": "ask smapi get-skill-status --skill-id amzn1.ask.skill.8f78057b-a2b4-4386-b4c4-c99d1f0244d7",
    "tf:init": "cd terraform && terraform init",
    "tf:plan": "cd terraform && terraform plan",
    "tf:apply": "cd terraform && terraform apply",
    "tf:destroy": "cd terraform && terraform destroy",
    "build:hosted": "rm -f dist/lambda-alexa-hosted.zip && mkdir -p dist && cd lambda && zip -qr ../dist/lambda-alexa-hosted.zip index.js config.js package.json src"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crsiebler/alexa-chatbot-conversation.git"
  },
  "keywords": [
    "alexa",
    "chatgpt",
    "openai",
    "conversation",
    "skill"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-model": "^1.41.1",
    "openai": "^4.20.1"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "lambda/src/**/*.js"
    ]
  }
}
